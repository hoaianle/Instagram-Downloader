{
    "name": "Instagram Downloader",
    "description": "Download Photos and Videos from Instagram Post, Reels, TV, Stories",
    "version": "6.0.5",
    "manifest_version": 3,
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": ["https://www.instagram.com/*", "https://*.fbcdn.net/*", "https://*.cdninstagram.com/*"],
    "action": {
        "default_icon": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.instagram.com/*"],
            "js": [
                "src/js/download-ui-preferences.js",
                "src/js/video-download-preferences.js",
                "src/js/filename-preferences.js",
                "src/js/settings-ui.js"
            ],
            "css": ["src/style/style.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://www.instagram.com/*"],
            "js": [
                "src/js/utils.js",
                "src/js/dash.js",
                "src/js/muxer-client.js",
                "src/js/post-media-selection.js",
                "src/js/download-views/feed.js",
                "src/js/download-views/modal.js",
                "src/js/download-views/detail.js",
                "src/js/download-views/reels.js",
                "src/js/download-views/router.js",
                "src/js/story-media-selection.js",
                "src/js/download-feedback.js",
                "src/js/legacy-media.js",
                "src/js/download-recovery.js",
                "src/js/inline-download.js",
                "src/js/story-inline-button.js",
                "src/js/post-inline-button.js",
                "src/js/main.js",
                "src/js/post.js",
                "src/js/story-data.js",
                "src/js/story.js",
                "src/js/highlight.js",
                "src/js/zip.js",
                "lib/js.cookie.min.js"
            ]
        },
        {
            "matches": ["https://www.instagram.com/*"],
            "js": [
                "src/js/global/utils.js",
                "src/js/global/home-scroll-handler.js",
                "src/js/global/story-owner-bridge.js",
                "src/js/global/post-modal-view-handler.js",
                "src/js/global/reels-scroll-handler.js"
            ],
            "css": [],
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/muxer/*", "lib/mp4box/*"],
            "matches": ["https://www.instagram.com/*"]
        }
    ]
}
